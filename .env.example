# Kopiere diese Datei nach .env und trage eigene Passwörter ein:
#   cp .env.example .env
# Die .env ist in .gitignore und wird nie committet.

# Passwort für den Betrachter (Benutzername: User) — darf alles lesen.
USER_PASSWORD=bitte-aendern-user

# Passwort für den Admin (Benutzername: Admin) — darf Inhalte anlegen und bearbeiten.
ADMIN_PASSWORD=bitte-aendern-admin

# Geheimer Schlüssel zum Signieren der Login-Cookies (lange Zufallszeichenkette).
# Erzeugen z. B. mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leer = bei jedem Serverstart neu (dann muss man sich nach einem Neustart erneut anmelden).
SESSION_SECRET=

# Wie lange ein Login gültig bleibt (Tage).
SESSION_DAYS=30

# --- Optional: Betrieb auf einem Server -------------------------------------
# Adresse, auf der der Server lauscht. Standard 127.0.0.1 (nur dieser Rechner).
# Hinter einem Reverse-Proxy bleibt das so; nur ohne Proxy auf 0.0.0.0 stellen.
# HOST=127.0.0.1
# API_PORT=4300
# Eigene Domain(s), unter denen die App erreichbar ist (Komma-getrennt, ".example.de" = inkl. Subdomains).
# ALLOWED_HOSTS=lernen.example.de
# Welchen Proxys X-Forwarded-For/-Proto geglaubt wird (Standard: Proxy auf demselben Rechner).
# TRUST_PROXY=loopback
# Cookies nur über HTTPS senden (auto = an, sobald die Anfrage per HTTPS kam).
# COOKIE_SECURE=auto
# Maximale Größe pro hochgeladener Datei in MB.
# MAX_UPLOAD_MB=50
