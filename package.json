{
  "name": "ba-mainz-lernplattform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lernplattform für den Master Business Administration der Hochschule Mainz — Semester, Fächer und Kapitel mit Notion-artigen Bausteinen, Login für Betrachter und Admin.",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "serve": "npm run build && npm start",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 e2e/*.test.js",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build",
    "licenses": "node scripts/licenses.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "cross-env": "^7.0.3",
    "express": "^4.21.2",
    "lucide-react": "^0.462.0",
    "multer": "^2.0.2",
    "nanoid": "^5.1.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "playwright": "^1.56.1",
    "vite": "^6.4.5"
  }
}
