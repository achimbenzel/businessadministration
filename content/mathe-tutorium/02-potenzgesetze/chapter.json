{
  "id": "mathe-02-potenzgesetze",
  "version": 2,
  "subjectId": "mathe-tutorium",
  "lang": "de",
  "after": "mathe-01-summen-produkt",
  "status": "published",
  "title": "Potenzgesetze – Exponentenregeln 1–6",
  "summary": "Die sechs Regeln für das Rechnen mit Potenzen – jeweils kurz erklärt mit Beispiel.",
  "blocks": [
    {
      "type": "text",
      "tab": "overview",
      "text": "Mit den sechs Potenzgesetzen lassen sich Ausdrücke mit Hochzahlen schnell vereinfachen. Vor jeder Umformung prüfen: **gleiche Basis** (Regeln 1–3) oder **gleicher Exponent** (Regeln 4–5)?"
    },
    {
      "type": "formula",
      "tab": "overview",
      "title": "Die 6 Regeln auf einen Blick",
      "text": "1   a^{x+y} = a^x \\cdot a^y\n2   a^{x−y} = \\frac{a^x}{a^y}\n3   (a^x)^y = a^{x \\cdot y}\n4   a^x \\cdot b^x = (a \\cdot b)^x\n5   \\frac{a^x}{b^x} = (\\frac{a}{b})^x\n6   a^0 = 1,  a^{−x} = \\frac{1}{a^x}",
      "variables": []
    },
    {
      "type": "callout",
      "tab": "overview",
      "variant": "tip",
      "title": "Merkhilfe",
      "text": "- Multiplizieren (gleiche Basis) → Exponenten **addieren**\n- Dividieren (gleiche Basis) → Exponenten **subtrahieren**\n- Potenz hoch Zahl → Exponenten **multiplizieren**"
    },
    {
      "type": "definition",
      "tab": "terms",
      "term": "Potenz",
      "text": "Kurzschrift für ein Produkt gleicher Faktoren: $a^n = a \\cdot a \\cdot \\dots \\cdot a$ (n-mal)."
    },
    {
      "type": "definition",
      "tab": "terms",
      "term": "Basis",
      "text": "Die Zahl, die mit sich selbst multipliziert wird – das a in $a^n$."
    },
    {
      "type": "definition",
      "tab": "terms",
      "term": "Exponent",
      "text": "Die Hochzahl – sie sagt, wie oft die Basis als Faktor vorkommt."
    },
    {
      "type": "definition",
      "tab": "terms",
      "term": "Kehrwert",
      "text": "Die „umgedrehte“ Zahl: Der Kehrwert von a ist $\\frac{1}{a}$."
    },
    {
      "type": "formula",
      "tab": "formulas",
      "title": "Regel 1: gleiche Basis multiplizieren",
      "text": "a^{x+y} = a^x \\cdot a^y",
      "variables": [],
      "explanation": "Gleiche Basis multiplizieren → Exponenten **addieren**.",
      "example": "$2^3 \\cdot 2^4 = 2^{3+4} = 2^7 = 128$"
    },
    {
      "type": "formula",
      "tab": "formulas",
      "title": "Regel 2: gleiche Basis dividieren",
      "text": "a^{x−y} = \\frac{a^x}{a^y}",
      "variables": [],
      "explanation": "Gleiche Basis dividieren → Exponenten **subtrahieren** (oben minus unten).",
      "example": "$\\frac{5^6}{5^4} = 5^{6−4} = 5^2 = 25$"
    },
    {
      "type": "formula",
      "tab": "formulas",
      "title": "Regel 3: Potenz einer Potenz",
      "text": "(a^x)^y = a^{x \\cdot y}",
      "variables": [],
      "explanation": "Eine Potenz noch einmal potenzieren → Exponenten **multiplizieren**.",
      "example": "$(3^2)^3 = 3^{2 \\cdot 3} = 3^6 = 729$"
    },
    {
      "type": "image",
      "tab": "formulas",
      "file": "img/potenzgesetze-kacheln.svg",
      "caption": "Regel 1 und 3 als Kacheln: a³ · a² sind fünf a, (a²)³ sind dreimal zwei a.",
      "alt": "Kacheln mit dem Buchstaben a: drei plus zwei Kacheln ergeben fünf; drei Gruppen zu je zwei Kacheln ergeben sechs."
    },
    {
      "type": "formula",
      "tab": "formulas",
      "title": "Regel 4: gleicher Exponent multiplizieren",
      "text": "a^x \\cdot b^x = (a \\cdot b)^x",
      "variables": [],
      "explanation": "Gleicher Exponent → Basen **multiplizieren**, Exponent bleibt.",
      "example": "$2^3 \\cdot 5^3 = (2 \\cdot 5)^3 = 10^3 = 1000$"
    },
    {
      "type": "formula",
      "tab": "formulas",
      "title": "Regel 5: gleicher Exponent dividieren",
      "text": "\\frac{a^x}{b^x} = (\\frac{a}{b})^x",
      "variables": [],
      "explanation": "Gleicher Exponent → Basen **dividieren**, Exponent bleibt.",
      "example": "$\\frac{12^2}{4^2} = 3^2 = 9$"
    },
    {
      "type": "formula",
      "tab": "formulas",
      "title": "Regel 6: Exponent null und negativ",
      "text": "a^0 = 1\na^{−x} = \\frac{1}{a^x}",
      "variables": [],
      "explanation": "Hoch 0 ergibt immer 1 (für a ≠ 0). Ein negativer Exponent bedeutet den **Kehrwert**.",
      "example": "$7^0 = 1$\n$2^{−3} = \\frac{1}{2^3} = \\frac{1}{8}$"
    },
    {
      "type": "heading",
      "tab": "practice",
      "text": "Aufgaben",
      "level": 2
    },
    {
      "type": "text",
      "tab": "practice",
      "text": "**Aufgabe 1.** Vereinfache $x^3 \\cdot x^5 \\cdot x^{−2}$."
    },
    {
      "type": "toggle",
      "tab": "practice",
      "title": "Lösung anzeigen",
      "text": "Regel 1: $x^{3+5−2} = x^6$"
    },
    {
      "type": "text",
      "tab": "practice",
      "text": "**Aufgabe 2.** Vereinfache $\\frac{a^7}{a^2}$."
    },
    {
      "type": "toggle",
      "tab": "practice",
      "title": "Lösung anzeigen",
      "text": "Regel 2: $a^{7−2} = a^5$"
    },
    {
      "type": "text",
      "tab": "practice",
      "text": "**Aufgabe 3.** Vereinfache $(x^4)^3$."
    },
    {
      "type": "toggle",
      "tab": "practice",
      "title": "Lösung anzeigen",
      "text": "Regel 3: $x^{4 \\cdot 3} = x^{12}$"
    },
    {
      "type": "text",
      "tab": "practice",
      "text": "**Aufgabe 4.** Berechne $4^2 \\cdot 25^2$ ohne Taschenrechner."
    },
    {
      "type": "toggle",
      "tab": "practice",
      "title": "Lösung anzeigen",
      "text": "Regel 4: $(4 \\cdot 25)^2 = 100^2 = 10000$"
    },
    {
      "type": "heading",
      "tab": "practice",
      "text": "Karteikarten",
      "level": 2
    },
    {
      "type": "flashcard",
      "tab": "practice",
      "front": "Regel 1: $a^x \\cdot a^y = ?$",
      "back": "$a^{x+y}$ – Exponenten addieren."
    },
    {
      "type": "flashcard",
      "tab": "practice",
      "front": "Regel 2: $\\frac{a^x}{a^y} = ?$",
      "back": "$a^{x−y}$ – Exponenten subtrahieren."
    },
    {
      "type": "flashcard",
      "tab": "practice",
      "front": "Regel 3: $(a^x)^y = ?$",
      "back": "$a^{x \\cdot y}$ – Exponenten multiplizieren."
    },
    {
      "type": "flashcard",
      "tab": "practice",
      "front": "Regel 4 und 5?",
      "back": "$a^x \\cdot b^x = (a \\cdot b)^x$ und $\\frac{a^x}{b^x} = (\\frac{a}{b})^x$"
    },
    {
      "type": "flashcard",
      "tab": "practice",
      "front": "Regel 6: $a^0$ und $a^{−x}$?",
      "back": "$a^0 = 1$ und $a^{−x} = \\frac{1}{a^x}$"
    },
    {
      "type": "heading",
      "tab": "practice",
      "text": "Quiz",
      "level": 2
    },
    {
      "type": "quiz",
      "tab": "practice",
      "question": "Was ergibt $2^3 \\cdot 2^4$?",
      "options": [
        {
          "text": "$4^{12}$",
          "correct": false
        },
        {
          "text": "$2^{12}$",
          "correct": false
        },
        {
          "text": "$4^7$",
          "correct": false
        },
        {
          "text": "$2^7 = 128$",
          "correct": true
        }
      ],
      "explanation": "Gleiche Basis: Exponenten addieren (Regel 1). Die Basis bleibt 2."
    },
    {
      "type": "quiz",
      "tab": "practice",
      "question": "Was ergibt $(x^2)^5$?",
      "options": [
        {
          "text": "$x^{10}$",
          "correct": true
        },
        {
          "text": "$x^7$",
          "correct": false
        },
        {
          "text": "$x^{25}$",
          "correct": false
        },
        {
          "text": "$2x^5$",
          "correct": false
        }
      ],
      "explanation": "Potenz einer Potenz: Exponenten multiplizieren (Regel 3)."
    },
    {
      "type": "quiz",
      "tab": "practice",
      "question": "Was ergibt $\\frac{x^8}{x^3}$?",
      "options": [
        {
          "text": "$x^{24}$",
          "correct": false
        },
        {
          "text": "$x^{11}$",
          "correct": false
        },
        {
          "text": "$x^{8/3}$",
          "correct": false
        },
        {
          "text": "$x^5$",
          "correct": true
        }
      ],
      "explanation": "Gleiche Basis dividieren: Exponenten subtrahieren (Regel 2)."
    },
    {
      "type": "quiz",
      "tab": "practice",
      "question": "Was ist $5^{−2}$?",
      "options": [
        {
          "text": "−25",
          "correct": false
        },
        {
          "text": "−10",
          "correct": false
        },
        {
          "text": "$\\frac{1}{25}$",
          "correct": true
        },
        {
          "text": "$\\frac{1}{10}$",
          "correct": false
        }
      ],
      "explanation": "Negativer Exponent = Kehrwert (Regel 6): $\\frac{1}{5^2} = \\frac{1}{25}$"
    }
  ]
}
