{
  "id": "mathe-01-summen-produkt",
  "version": 2,
  "subjectId": "mathe-tutorium",
  "lang": "de",
  "status": "published",
  "title": "Summen- und Produktzeichen (Σ und Π)",
  "summary": "Lange Summen und Produkte kurz schreiben und ausrechnen.",
  "blocks": [
    {
      "type": "text",
      "tab": "overview",
      "text": "**Σ** (Summenzeichen) heißt „addiere alle …“, **Π** (Produktzeichen) heißt „multipliziere alle …“. Unten steht, womit man anfängt, oben, wo man aufhört."
    },
    {
      "type": "definition",
      "tab": "terms",
      "term": "Summenzeichen Σ",
      "text": "Kurzschrift für eine Summe: Alle Summanden von der unteren bis zur oberen Grenze werden addiert."
    },
    {
      "type": "definition",
      "tab": "terms",
      "term": "Produktzeichen Π",
      "text": "Kurzschrift für ein Produkt: Alle Faktoren von der unteren bis zur oberen Grenze werden multipliziert."
    },
    {
      "type": "definition",
      "tab": "terms",
      "term": "Laufindex",
      "text": "Die Zählvariable unter dem Zeichen (meist i oder k). Sie läuft in Einerschritten von der unteren bis zur oberen Grenze."
    },
    {
      "type": "definition",
      "tab": "terms",
      "term": "Untere und obere Grenze",
      "text": "Start- und Endwert des Laufindex – beide zählen mit."
    },
    {
      "type": "formula",
      "tab": "formulas",
      "title": "Summenzeichen",
      "text": "\\sum_{i=1}^{n} a_i = a_1 + a_2 + \\dots + a_n",
      "variables": [
        {
          "symbol": "i",
          "meaning": "Laufindex"
        },
        {
          "symbol": "1 / n",
          "meaning": "untere / obere Grenze"
        },
        {
          "symbol": "a_i",
          "meaning": "Summand"
        }
      ],
      "explanation": "Für i nacheinander 1, 2, …, n einsetzen und alle Ergebnisse **addieren**.",
      "example": "$\\sum_{i=1}^{4} i^2 = 1 + 4 + 9 + 16 = 30$"
    },
    {
      "type": "image",
      "tab": "formulas",
      "file": "img/summenzeichen-aufbau.svg",
      "caption": "Aufbau des Summenzeichens.",
      "alt": "Sigma-Zeichen mit oberer Grenze n, Laufindex i mit Startwert 1 und Summand a mit Index i."
    },
    {
      "type": "formula",
      "tab": "formulas",
      "title": "Produktzeichen",
      "text": "\\prod_{i=1}^{n} a_i = a_1 \\cdot a_2 \\cdot \\dots \\cdot a_n",
      "variables": [
        {
          "symbol": "i",
          "meaning": "Laufindex"
        },
        {
          "symbol": "1 / n",
          "meaning": "untere / obere Grenze"
        },
        {
          "symbol": "a_i",
          "meaning": "Faktor"
        }
      ],
      "explanation": "Genau wie beim Summenzeichen – nur wird **multipliziert**.",
      "example": "$\\prod_{i=1}^{4} i = 1 \\cdot 2 \\cdot 3 \\cdot 4 = 24$"
    },
    {
      "type": "image",
      "tab": "formulas",
      "file": "img/produktzeichen-aufbau.svg",
      "caption": "Aufbau des Produktzeichens.",
      "alt": "Pi-Zeichen mit oberer Grenze n, Laufindex i mit Startwert 1 und Faktor a mit Index i."
    },
    {
      "type": "heading",
      "tab": "practice",
      "text": "Aufgaben",
      "level": 2
    },
    {
      "type": "text",
      "tab": "practice",
      "text": "**Aufgabe 1.** Berechne $\\sum_{i=1}^{5} 2i$."
    },
    {
      "type": "toggle",
      "tab": "practice",
      "title": "Lösung anzeigen",
      "text": "2 + 4 + 6 + 8 + 10 = **30**"
    },
    {
      "type": "text",
      "tab": "practice",
      "text": "**Aufgabe 2.** Schreibe 1 + 4 + 9 + 16 + 25 mit dem Summenzeichen."
    },
    {
      "type": "toggle",
      "tab": "practice",
      "title": "Lösung anzeigen",
      "text": "$\\sum_{i=1}^{5} i^2$"
    },
    {
      "type": "text",
      "tab": "practice",
      "text": "**Aufgabe 3.** Berechne $\\prod_{k=1}^{3} (k + 1)$."
    },
    {
      "type": "toggle",
      "tab": "practice",
      "title": "Lösung anzeigen",
      "text": "2 · 3 · 4 = **24**"
    },
    {
      "type": "heading",
      "tab": "practice",
      "text": "Karteikarten",
      "level": 2
    },
    {
      "type": "flashcard",
      "tab": "practice",
      "front": "Was bedeutet $\\sum_{i=1}^{n} a_i$?",
      "back": "$a_1 + a_2 + \\dots + a_n$ – alle Summanden von i = 1 bis n addieren."
    },
    {
      "type": "flashcard",
      "tab": "practice",
      "front": "Was bedeutet $\\prod_{i=1}^{n} a_i$?",
      "back": "$a_1 \\cdot a_2 \\cdot \\dots \\cdot a_n$ – alle Faktoren von i = 1 bis n multiplizieren."
    },
    {
      "type": "flashcard",
      "tab": "practice",
      "front": "Was ist der Laufindex?",
      "back": "Die Zählvariable unter dem Zeichen; sie läuft von der unteren bis zur oberen Grenze."
    },
    {
      "type": "heading",
      "tab": "practice",
      "text": "Quiz",
      "level": 2
    },
    {
